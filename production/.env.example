# Generate a working LOCAL configuration with: python scripts/init_demo.py
# This template documents production configuration; replace every placeholder.
ENVIRONMENT=production
AUTH_MODE=entra
MODEL_PROVIDER=azure
ENTRA_TENANT_ID=<entra-directory-uuid>
API_AUDIENCE=<api-application-client-id>
REQUIRED_SCOPE=analytics.access
UI_CLIENT_ID=<public-client-application-id>
API_SCOPE=api://<api-application-client-id>/analytics.access
ALLOWED_HOSTS=["analytics-api.example.com"]

# Use separate logins and sslmode=verify-full; mount the trusted CA if required.
QUERY_DSN=postgresql://analytics_gateway:<password>@<private-postgres-host>/analytics?sslmode=verify-full
CONTROL_DSN=postgresql://analytics_control:<password>@<private-postgres-host>/analytics?sslmode=verify-full
CHECKPOINT_DSN=postgresql://analytics_checkpoint:<password>@<private-postgres-host>/analytics?sslmode=verify-full

# Migration job only. NEVER inject these administrator credentials into the API or UI.
MIGRATION_DSN=postgresql://<migration-admin>:<password>@<private-postgres-host>/analytics?sslmode=verify-full
QUERY_DB_PASSWORD=<random-at-least-24-characters>
CONTROL_DB_PASSWORD=<random-at-least-24-characters>
CHECKPOINT_DB_PASSWORD=<random-at-least-24-characters>

AZURE_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_API_VERSION=2024-10-21
MODEL_NAME=<your-deployed-model-name>
MODEL_API_KEY=<key-vault-injected-secret>
MAX_MODEL_CALLS=6
MAX_SQL_REPAIRS=2
MAX_ROWS=1000
MAX_RESULT_BYTES=2000000
STATEMENT_TIMEOUT_MS=10000
REQUEST_TIMEOUT_SECONDS=45
REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_QUERIES=8
